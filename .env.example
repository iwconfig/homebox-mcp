# URL for your Homebox instance
HOMEBOX_LOCAL_URL=http://10.0.0.4:7745

# --- Authentication (Choose one) ---

# Recommended: Use an API Key
HOMEBOX_API_KEY=your_api_key_here

# Alternative: Use Username/Password
#HOMEBOX_USERNAME=your_email@example.com
#HOMEBOX_PASSWORD=your_password_here

# --- Optional Settings ---

# URL for links if you access Homebox externally
#HOMEBOX_WAN_URL=https://homebox.yourdomain.com

# SSE Server settings
#MCP_TRANSPORT=sse
#MCP_HOST=0.0.0.0
#MCP_PORT=8000
