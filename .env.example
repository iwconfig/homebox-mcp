# Homebox Connection
HOMEBOX_LOCAL_URL=http://localhost:7745
HOMEBOX_WAN_URL=
USE_LAN_API=true

# Authentication (Defaults)
HOMEBOX_API_KEY=
HOMEBOX_USERNAME=
HOMEBOX_PASSWORD=

# MCP Settings
MCP_TRANSPORT=stdio
MCP_PORT=8000

# Guardrails: User Protection (Email based)
# HOMEBOX_PROTECTED_USERS: Blocks update and delete for specific emails or 'all'
HOMEBOX_PROTECTED_USERS=
# HOMEBOX_NON_DELETABLE_USERS: Blocks delete and email changes for specific emails or 'all'
HOMEBOX_NON_DELETABLE_USERS=

# Guardrails: Resource Type Protection
# Options: items, locations, labels, templates, users
# HOMEBOX_READONLY_RESOURCES: Blocks create, update, delete for listed types or 'all'
HOMEBOX_READONLY_RESOURCES=
# HOMEBOX_NON_DELETABLE_RESOURCES: Blocks delete for listed types or 'all'
HOMEBOX_NON_DELETABLE_RESOURCES=

# Guardrails: Specific Object Protection (UUID based)
# HOMEBOX_PROTECTED_IDS: Blocks update and delete for specific UUIDs or 'all'
HOMEBOX_PROTECTED_IDS=
# HOMEBOX_NON_DELETABLE_IDS: Blocks delete for specific UUIDs or 'all'
HOMEBOX_NON_DELETABLE_IDS=